# ---------------------------------------------------------------------------
# Everything here is server-side. No key in this file may be prefixed with
# NEXT_PUBLIC_ except the analytics flag, which carries no secret.
# Copy to .env.local and fill in what you have — the app degrades in documented
# ways rather than breaking when a service is missing.
# ---------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Without these the app uses a local JSON store under .data/ (development only).
# Find them under Project Settings → API. The service-role key bypasses RLS, so
# it must never reach the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mode -----------------------------------------------------------------
# The single switch that decides whether the app talks to real models.
#   mock   -> bundled receipt fixtures, no API calls, no cost
#   openai -> real multimodal receipt parsing; a failure is an error, never a
#             silent fall back to fixture data
# Unset defaults to mock, or to openai when OPENAI_API_KEY is present.
AI_PROVIDER=mock

# Which bundled fixture mock mode replays. See src/fixtures/receipts.ts.
MOCK_RECEIPT_FIXTURE=trader-joes

# --- OpenAI ---------------------------------------------------------------
# Required whenever AI_PROVIDER=openai. With AI_PROVIDER=openai and no key,
# receipt scanning fails with a recoverable error — it does NOT fall back to
# fixture data. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Any Responses API model with vision and structured outputs.
OPENAI_MODEL=gpt-5
# Receipts are transcription, not reasoning — a cheaper model is usually enough.
OPENAI_RECEIPT_MODEL=

# Cost telemetry uses a built-in price table. Override when prices change
# rather than editing code (USD per million tokens).
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Deprecated, superseded by AI_PROVIDER. Still honoured: "openai" | "fixture".
RECEIPT_PARSER=
# Set to "off" to stop recipe discovery from using web search.
RECIPE_WEB_SEARCH=

# --- YouTube (cooking videos) ---------------------------------------------
# Required for the "Watch recipe" experience. Without it the app shows written
# steps only and says so — it never invents a video link.
#
# Setup:
#   1. https://console.cloud.google.com/ → create or pick a project
#   2. APIs & Services → Library → enable "YouTube Data API v3"
#   3. APIs & Services → Credentials → Create credentials → API key
#   4. Restrict the key to the YouTube Data API v3 (recommended)
#
# Quota: 10,000 units/day free, no billing required. A search costs 100 units
# and the follow-up details call costs 1, so ~99 new dishes per day. Resolved
# sources are cached on the recipe forever, so the 18-recipe catalog costs about
# 18 searches in total and then nothing.
YOUTUBE_API_KEY=

# --- Nutrition ------------------------------------------------------------
# USDA FoodData Central. Free key: https://fdc.nal.usda.gov/api-key-signup.html
# Without it, enrichment uses the built-in generic table and labels values as
# estimates.
FDC_API_KEY=

# --- Analytics ------------------------------------------------------------
# Events are defined and fired regardless; this decides whether they go
# anywhere. No provider is connected yet.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# --- Local development ----------------------------------------------------
# Where the local JSON store lives. Defaults to .data/meals.json.
LOCAL_DB_PATH=
# Reuse an already-installed Chromium when rendering fixtures.
CHROMIUM_PATH=

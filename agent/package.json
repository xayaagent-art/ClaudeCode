{
  "name": "aiden-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Mineflayer-controlled Minecraft agent (Phase 1: no LLM layer)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:built": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "minecraft-data": "^3.112.0",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "vec3": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  }
}

# ---------------------------------------------------------------------------
# Aiden — Minecraft agent configuration
#
# Copy to `.env` and adjust:  cp .env.example .env
# The server bootstrap writes a matching `.env` for you automatically.
# ---------------------------------------------------------------------------

# --- Server connection -----------------------------------------------------
# The Paper server runs on the same Mac as the agent, so localhost is correct.
# This is the JAVA port (25565), NOT the Bedrock/Geyser port (19132).
MC_HOST=127.0.0.1
MC_PORT=25565

# Minecraft version to speak. `auto` lets mineflayer negotiate with the server,
# which is what you want unless you are debugging a protocol mismatch.
MC_VERSION=auto

# --- Bot identity ----------------------------------------------------------
BOT_USERNAME=Aiden

# `offline` = no Mojang/Microsoft account needed. This only works because the
# LAN dev server runs with online-mode=false. Never use offline mode on a
# server that is reachable from the internet.
MC_AUTH=offline

# --- Behaviour -------------------------------------------------------------
# Prefix for chat commands, e.g. `!come`.
COMMAND_PREFIX=!

# debug | info | warn | error
LOG_LEVEL=info

# Automatic reconnect backoff (milliseconds).
RECONNECT_INITIAL_MS=2000
RECONNECT_MAX_MS=30000

# How often to print position/health/hunger/inventory to the terminal.
# Set to 0 to disable the periodic print.
STATUS_INTERVAL_MS=30000

# Block-scan radius used by `!look`.
OBSERVE_RADIUS=16

# ---------------------------------------------------------------------------
# Phase 2 (NOT used yet — no LLM layer is wired up in Phase 1)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=
